# ============================================================
# 部署连接配置示例
#
# 使用方式：
#   1) 复制本文件为同目录下的 deploy.env：
#        cp deploy.env.example deploy.env
#   2) 按实际情况填写下面的值。
#   deploy.env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================

# Ubuntu 服务器地址
DEPLOY_HOST="192.168.1.100"
DEPLOY_PORT="22"

# 登录用户名
DEPLOY_USER="your_username"

# 二选一：推荐使用 SSH 私钥（更安全）；不使用密钥时填写密码
# 注意：密码含特殊字符时请用双引号包裹
DEPLOY_PASSWORD=""
DEPLOY_SSH_KEY=""

# 本地项目目录（dataBase 目录，Windows 路径请保留双引号）
DEPLOY_LOCAL_BASE="D:\path\to\dataBase"

# Ubuntu 上的项目目录
DEPLOY_REMOTE_BASE="/home/your_username/dataBase"
